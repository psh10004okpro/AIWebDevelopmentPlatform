// Prisma Schema for NextGen AI Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 모델
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]

  @@map("users")
}

// NextAuth용 Account 모델
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth용 Session 모델
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth용 VerificationToken 모델
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 프로젝트 모델
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  template    String   @default("react") // react, nextjs, vue 등
  visibility  String   @default("private") // private, public
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  files File[]

  @@index([userId])
  @@map("projects")
}

// 파일 모델
model File {
  id        String   @id @default(cuid())
  name      String
  path      String
  content   String   @db.Text
  language  String   @default("typescript")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("files")
}

// AI 코드 생성 로그
model GenerationLog {
  id        String   @id @default(cuid())
  prompt    String   @db.Text
  code      String   @db.Text
  model     String // claude-3, gpt-4 등
  tokens    Int?
  duration  Int? // milliseconds
  success   Boolean  @default(true)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("generation_logs")
}
