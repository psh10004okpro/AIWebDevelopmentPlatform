# Kubernetes Secrets Template
# DO NOT commit actual secrets to git
# Use AWS Secrets Manager or kubectl create secret for production

apiVersion: v1
kind: Secret
metadata:
  name: nextgen-ai-platform-secrets
  namespace: nextgen-ai-platform
type: Opaque
stringData:
  # Database
  DATABASE_URL: postgresql://username:password@postgres-service:5432/nextgen_ai_platform

  # AI Provider API Keys
  ANTHROPIC_API_KEY: sk-ant-xxxxx
  OPENAI_API_KEY: sk-xxxxx
  HYPERCLOVA_API_KEY: xxxxx
  HYPERCLOVA_API_KEY_PRIMARY_VAL: xxxxx
  HYPERCLOVA_APIGW_API_KEY: xxxxx

  # OAuth Credentials
  GITHUB_ID: xxxxx
  GITHUB_SECRET: xxxxx
  GOOGLE_ID: xxxxx
  GOOGLE_SECRET: xxxxx
  KAKAO_CLIENT_ID: xxxxx
  KAKAO_CLIENT_SECRET: xxxxx
  NAVER_CLIENT_ID: xxxxx
  NAVER_CLIENT_SECRET: xxxxx

  # NextAuth
  NEXTAUTH_SECRET: generate-with-openssl-rand-base64-32

---
# Use this command to create secrets from file:
# kubectl create secret generic nextgen-ai-platform-secrets \
#   --from-env-file=.env.production \
#   --namespace=nextgen-ai-platform

# Or use AWS Secrets Manager with External Secrets Operator:
# https://external-secrets.io/
