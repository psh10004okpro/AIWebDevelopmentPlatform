# Environment Configuration

# Node Environment
NODE_ENV=development

# API Configuration
API_PORT=3001
API_URL=http://localhost:3001

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_ORCHESTRATOR_URL=http://localhost:3002

# Services
AI_ORCHESTRATOR_PORT=3002
AI_ORCHESTRATOR_URL=http://localhost:3002
RAG_SERVICE_PORT=3005
RAG_SERVICE_URL=http://localhost:3005
SECURITY_ENHANCER_PORT=3006
SECURITY_ENHANCER_URL=http://localhost:3006
CODE_GENERATOR_PORT=3003
PREVIEW_ENGINE_PORT=3004

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextgen_ai_platform

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333

# AI Services (Add your API keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
DEFAULT_AI_PROVIDER=claude

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production

# OAuth Providers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
